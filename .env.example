# Every variable is optional — a missing integration only disables its feature.

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OPTIONAL — Spotify now-playing
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OPTIONAL — Contact Form
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# SMTP — without it, dev logs submissions to the console and production
# answers 503 ("form offline") instead of pretending the message was sent
# Gmail: use App Password, not your actual password
# Resend: SMTP_USER=resend, SMTP_PASS=re_xxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Inbox that receives messages (defaults to the address in src/config/site.ts)
CONTACT_EMAIL=

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OPTIONAL — Monitoring & Analytics
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Sentry — https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Cloudflare Web Analytics beacon token
NEXT_PUBLIC_CF_BEACON_TOKEN=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OPTIONAL — Infrastructure
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Cloudflare R2 CDN — resume PDFs only (MDX ships with the app for SSR/SEO)
# Public R2 URL, no trailing slash, e.g. https://content.agus-darmawan.com
# (empty → the resume window shows an error and /about hides the CV link)
NEXT_PUBLIC_CONTENT_URL=

# Google Search Console → Settings → Ownership verification → HTML tag (content value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cloudflare Worker for Spotify (optional, falls back to /api/spotify)
NEXT_PUBLIC_SPOTIFY_WORKER_URL=

# App base URL — used for OG image and social meta
# Dev: http://localhost:3000 | Prod: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Analytics API (for visitor counter in terminal)
CF_ACCOUNT_ID=
CF_SITE_TAG=
CF_API_TOKEN=

# GitHub token — project stars/forks + repos tagged `portfolio`
# (fine-grained, public read-only; raises rate limit from 60 to 5000 req/h)
GITHUB_TOKEN=
